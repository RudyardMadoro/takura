FROM node:24.19.0-alpine3.23 AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml angular.json tsconfig.json ./
COPY apps/public-web apps/public-web
COPY libs libs
RUN pnpm install --frozen-lockfile
ENV TAKURA_PUBLIC_SITE_MODE=PRODUCTION
RUN pnpm build:public

FROM node:24.19.0-alpine3.23
ENV NODE_ENV=production PORT=4000
WORKDIR /app
COPY --from=build --chown=node:node /workspace/dist/public-web ./
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:4000/ || exit 1
CMD ["node", "server/server.mjs"]
