FROM node:24.19.0-alpine3.23 AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml angular.json tsconfig.json ./
COPY apps/staff-web apps/staff-web
COPY libs libs
RUN pnpm install --frozen-lockfile
RUN pnpm build:staff

FROM nginxinc/nginx-unprivileged:1.29.5-alpine3.23
COPY infra/contabo/staff-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/staff-web/browser /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/admin/ || exit 1
