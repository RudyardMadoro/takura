# Local-only example values. Copy to .env and replace outside development.
TAKURA_ENVIRONMENT=local
DATABASE_NAME=takura
DATABASE_HOST_PORT=15432
DATABASE_URL=jdbc:postgresql://localhost:15432/takura
DATABASE_MIGRATION_USER=takura_migrator
DATABASE_MIGRATION_PASSWORD=local-migration-only
DATABASE_RUNTIME_USER=takura_runtime
DATABASE_RUNTIME_PASSWORD=local-runtime-only
TEST_SINK_ADDRESS=notifications@example.invalid
PAYMENT_ENABLED=false
FAKE_AUTHENTICATION_ENABLED=true
FAKE_MALWARE_SCANNING_ENABLED=true
