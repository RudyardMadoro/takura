{
  "title": "Takura operations",
  "uid": "takura-ops",
  "schemaVersion": 41,
  "panels": [
    {
      "type": "timeseries",
      "title": "API latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(takura_http_server_duration_seconds_bucket[5m])))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Notification age",
      "targets": [{ "expr": "takura_notification_oldest_seconds" }],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Scan age",
      "targets": [{ "expr": "takura_scan_oldest_seconds" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    }
  ]
}
