{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PinExactQuarantineVersion",
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion", "s3:GetObjectVersionAttributes"],
      "Resource": "arn:aws:s3:::REPLACE-quarantine/quarantine/*"
    },
    {
      "Sid": "WritePrivateClean",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE-private-clean/private/*"
    },
    {
      "Sid": "WriteApprovedDerivatives",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE-approved-public/derivatives/*"
    }
  ]
}
