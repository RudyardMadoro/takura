{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadApprovedDerivativesOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE-approved-public/derivatives/*",
      "Condition": {
        "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::REPLACE:distribution/REPLACE" }
      }
    }
  ]
}
