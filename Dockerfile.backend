FROM eclipse-temurin:21.0.9_10-jdk-alpine-3.23 AS build
WORKDIR /workspace
COPY backend/mvnw backend/mvnw.cmd backend/pom.xml ./
COPY backend/.mvn ./.mvn
COPY backend/src ./src
RUN chmod +x mvnw && ./mvnw -B -DskipTests package

FROM eclipse-temurin:21.0.9_10-jre-alpine-3.23
RUN addgroup -S takura && adduser -S -G takura -u 10001 takura
WORKDIR /app
COPY --from=build --chown=takura:takura /workspace/target/backend-0.1.0-SNAPSHOT.jar /app/application.jar
USER 10001
EXPOSE 8080 9090
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:9090/actuator/health/readiness || exit 1
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-Djava.io.tmpdir=/tmp", "-jar", "/app/application.jar"]
